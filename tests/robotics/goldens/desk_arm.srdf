<?xml version='1.0' encoding='utf-8'?>
<robot name="desk_arm">
  <group name="arm">
    <chain base_link="base" tip_link="hand" />
  </group>
  <group name="gripper">
    <joint name="grip" />
  </group>
  <end_effector name="hand_ee" parent_link="hand" group="gripper" />
  <group_state name="home" group="arm">
    <joint name="base_yaw" value="0" />
    <joint name="shoulder" value="0" />
    <joint name="elbow" value="0" />
    <joint name="wrist" value="0" />
  </group_state>
  <disable_collisions link1="base" link2="turret" reason="Adjacent" />
  <disable_collisions link1="turret" link2="upperarm" reason="Adjacent" />
  <disable_collisions link1="upperarm" link2="forearm" reason="Adjacent" />
  <disable_collisions link1="forearm" link2="hand" reason="Adjacent" />
  <disable_collisions link1="hand" link2="jaw" reason="Adjacent" />
</robot>