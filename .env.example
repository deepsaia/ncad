# .env.example - ncad serve configuration.
# Copy to .env and `export $(grep -v '^#' .env | xargs)` or set these in your shell.
# ncad reads these via os.environ (no dotenv dependency); every value has a safe default,
# so `ncad serve` works with none of them set. CLI flags override env (flag > env > default).

# --- ncad serve: server ---
NCAD_HOST=127.0.0.1          # bind address
NCAD_PORT=8000               # bind port (0 = ephemeral)
NCAD_DEV=0                   # 1 = hot-reload (server autoreload + browser live-reload)

# --- ncad serve: build concurrency ---
# Builds run in a spawn process pool off the event loop, so requests never block each other.
# Each worker imports OCP/OCCT (a heavy, few-hundred-MB process), so the auto-default is small.
NCAD_MAX_WORKERS=            # pool size; blank = auto: max(1, min(4, cpu_count - 2)).
                             # Set explicitly to raise it on a big machine (e.g. 12); this
                             # overrides the auto cap-of-4 entirely.
NCAD_MAX_CONCURRENT_BUILDS=  # in-flight builds before queueing; blank = NCAD_MAX_WORKERS
NCAD_JOB_QUEUE_MAX=32        # queued-jobs bound; submit returns 503 past (concurrent + this)
NCAD_JOB_TTL=300             # seconds a finished job is retained (then evicted; bounds memory)
NCAD_JOB_POLL_MS=400         # frontend job-status poll interval (injected into the viewer page)
NCAD_SHUTDOWN_TIMEOUT=30     # seconds to drain in-flight builds before force-stop on shutdown
NCAD_JOBS_DIR=               # per-job progress-file dir; blank = <out>/.jobs

# --- external tools (existing) ---
NCAD_CCX=                    # explicit CalculiX ccx path; blank = search PATH
